# 複製成 .env 後填入實際值
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ .env 已被 .gitignore 排除，不要強制 git add

# LiteLLM 管理金鑰（自行產生，建議 openssl rand -hex 32）
LITELLM_MASTER_KEY=sk-CHANGE-ME

# Postgres 密碼
PG_PASSWORD=CHANGE-ME

# ===== 上游 Provider 金鑰 =====
AGNES_API_KEY=CHANGE-ME

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
