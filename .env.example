# 複製成 .env 後填入實際值
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ .env 已被 .gitignore 排除，不要強制 git add

# LiteLLM 管理金鑰（自行產生，建議 openssl rand -hex 32）
LITELLM_MASTER_KEY=sk-CHANGE-ME

# Postgres 密碼
PG_PASSWORD=CHANGE-ME

# LiteLLM 副本數（nginx 會平均分流），約每 1 vCPU 一個；改完 up -d 即生效
# LITELLM_REPLICAS=4

# Admin UI 登入（選填）— 不設的話預設帳號 admin、密碼 = LITELLM_MASTER_KEY
# UI_USERNAME=admin
# UI_PASSWORD=

# ===== 上游 Provider 金鑰 =====
# 填了之後，到 litellm/config.yaml 把對應模型解除註解（或在 Web UI 新增）
AGNES_API_KEY=CHANGE-ME

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
